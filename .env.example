# InstantReplyHub Ortam Değişkenleri

# 1. Supabase Yapılandırması
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
